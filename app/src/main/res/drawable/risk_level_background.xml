<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ระดับความเสี่ยงสูง (แดง) -->
    <item android:state_selected="true" android:tag="high">
        <shape android:shape="rectangle">
            <solid android:color="#FFEBEE"/>
            <stroke android:width="1dp" android:color="#E74C3C"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>

    <!-- ระดับความเสี่ยงปานกลาง (เหลือง) -->
    <item android:state_selected="true" android:tag="medium">
        <shape android:shape="rectangle">
            <solid android:color="#FFF8E1"/>
            <stroke android:width="1dp" android:color="#F39C12"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>

    <!-- ระดับความเสี่ยงต่ำ (เขียว) -->
    <item android:state_selected="true" android:tag="low">
        <shape android:shape="rectangle">
            <solid android:color="#E8F5E8"/>
            <stroke android:width="1dp" android:color="#27AE60"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>

    <!-- สถานะปกติ -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F8F9FA"/>
            <stroke android:width="1dp" android:color="#E9ECEF"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>

</selector>