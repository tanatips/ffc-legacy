<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- สีพื้นหลัง -->
    <solid android:color="#FFFFFF" />

    <!-- เส้นขอบ -->
    <stroke
        android:width="1dp"
        android:color="#E0E0E0" />

    <!-- มุมโค้ง -->
    <corners android:radius="8dp" />

    <!-- เงา/ระยะห่าง -->
    <padding
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp" />

</shape>