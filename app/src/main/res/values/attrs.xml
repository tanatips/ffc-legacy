<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="ImageMap">
        <attr name="map" format="string"/>
    </declare-styleable>
    <declare-styleable name="WaveformView">
        <attr name="waveColor" format="color"/>
        <attr name="backgroundColor" format="color"/>
        <attr name="lineWidth" format="dimension"/>
        <attr name="pointStep" format="dimension"/>
        <attr name="bufferSize" format="integer"/>
        <attr name="maxValue" format="integer"/>
    </declare-styleable>
    <declare-styleable name="SuicideRiskGaugeView">
        <attr name="gaugeSize" format="dimension" />
        <attr name="arcWidth" format="dimension" />
        <attr name="needleColor" format="color" />
        <attr name="textColor" format="color" />

        <attr name="animationDuration" format="integer" />
        <attr name="showScaleNumbers" format="boolean" />
        <attr name="minScore" format="integer" />
        <attr name="maxScore" format="integer" />
    </declare-styleable>
</resources>
