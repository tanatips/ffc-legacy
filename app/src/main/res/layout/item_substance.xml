<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@color/light_blue">

    <!-- แถวที่ 1: TextView และ TextInputLayout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- ส่วนของ TextView -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/text_color" />

            <TextView
                android:id="@+id/descriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_color"
                android:layout_marginTop="4dp" />


        <!-- ส่วนของ TextInputLayout ลดขนาดลงเหลือ 150dp -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/otherSubstanceLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/otherSubstanceEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="35dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:hint="ระบุสารเสพติดอื่นๆ"
                android:inputType="text"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- แถวที่ 2: RadioGroup ชิดซ้าย -->
    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="start">

        <RadioButton
            android:id="@+id/radioNotUsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ไม่เคย"
            android:layout_marginEnd="16dp" />

        <RadioButton
            android:id="@+id/radioUsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="เคย" />
    </RadioGroup>

</LinearLayout>