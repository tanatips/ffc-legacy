<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".app.form.screening.StressDepression2qFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ส่วนหัวของหน้า -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_dialog_info"
                android:tint="#673AB7"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="การคัดกรองโรคซึมเศร้าด้วย 2 คำถาม (2Q)"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2C3E50" />
        </LinearLayout>

        <!-- คำอธิบาย -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#E8F5E8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 คำแนะนำ"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#27AE60"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="กรุณาตอบคำถามเกี่ยวกับความรู้สึกของท่านใน 2 สัปดาห์ที่ผ่านมารวมทั้งวันนี้"
                    android:textSize="14sp"
                    android:textColor="#2C3E50"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Hidden Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_margin="10dp"
            android:textStyle="bold"
            android:text="การคัดกรองโรคซึมเศร้าด้วย 2 คำถาม (2Q)"
            android:visibility="gone" />

        <!-- คำถามที่ 1 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:gravity="center"
                        android:layout_marginRight="12dp"
                        android:minWidth="28dp"
                        android:minHeight="28dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ใน 2 สัปดาห์ที่ผ่านมารวมวันนี้ ท่านรู้สึกหดหู่เศร้าหรือท้อแท้สิ้นหวัง หรือไม่"
                        android:textSize="16sp"
                        android:textColor="#2C3E50"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioGroup
                        android:id="@+id/rdoStress2qQ1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="20dp">

                        <RadioButton
                            android:id="@+id/rdoStress2qQ1_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ไม่มี"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#673AB7"
                            android:padding="12dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoStress2qQ1_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="มี"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#673AB7"
                            android:padding="12dp"
                            android:background="?android:attr/selectableItemBackground" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำถามที่ 2 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:gravity="center"
                        android:layout_marginRight="12dp"
                        android:minWidth="28dp"
                        android:minHeight="28dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ใน 2 สัปดาห์ที่ผ่านมารวมวันนี้ ท่านรู้สึกเบื่อ ทำอะไรก็ไม่เพลิดเพลิน หรือไม่"
                        android:textSize="16sp"
                        android:textColor="#2C3E50"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioGroup
                        android:id="@+id/rdoStress2qQ2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="20dp">

                        <RadioButton
                            android:id="@+id/rdoStress2qQ2_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ไม่มี"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#673AB7"
                            android:padding="12dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoStress2qQ2_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="มี"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#673AB7"
                            android:padding="12dp"
                            android:background="?android:attr/selectableItemBackground" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ส่วนผลการประเมิน -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 ผลการประเมิน"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true">

                    <TableLayout
                        android:id="@+id/depression2resultTable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="*"
                        android:shrinkColumns="*"
                        android:background="#FFFFFF">

                        <!-- หัวตาราง -->
                        <TableRow
                            android:background="#673AB7"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="ผลการคัดกรอง"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:padding="8dp"
                                android:gravity="center" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="การแปลผล"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:padding="8dp"
                                android:gravity="center" />
                        </TableRow>

                        <!-- แถวปกติ -->
                        <TableRow
                            android:padding="12dp"
                            android:background="#E8F5E8">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="ตอบว่า 'ไม่มี' ทั้ง 2 คำถาม"
                                android:textSize="15sp"
                                android:textColor="#2C3E50"
                                android:padding="8dp"
                                android:lineSpacingExtra="2dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="ปกติ\n(1B0210)"
                                android:textSize="15sp"
                                android:textColor="#27AE60"
                                android:textStyle="bold"
                                android:padding="8dp"
                                android:gravity="center"
                                android:lineSpacingExtra="2dp" />
                        </TableRow>

                        <!-- แถวผิดปกติ -->
                        <TableRow
                            android:padding="12dp"
                            android:background="#FFEBEE">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="ตอบว่า 'มี' อย่างน้อย 1 คำถาม"
                                android:textSize="15sp"
                                android:textColor="#2C3E50"
                                android:padding="8dp"
                                android:lineSpacingExtra="2dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="ผิดปกติ และส่งต่อเจ้าหน้าที่\n(1B0211)"
                                android:textSize="15sp"
                                android:textColor="#E74C3C"
                                android:textStyle="bold"
                                android:padding="8dp"
                                android:gravity="center"
                                android:lineSpacingExtra="2dp" />
                        </TableRow>
                    </TableLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำแนะนำเพิ่มเติม -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFF3E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp" android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠️ หมายเหตุ"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FF9800"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="หากผลการประเมินออกมาผิดปกติ ควรปรึกษาแพทย์หรือเจ้าหน้าที่สาธารณสุขเพื่อการประเมินและดูแลเพิ่มเติม"
                    android:textSize="14sp"
                    android:textColor="#2C3E50"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>