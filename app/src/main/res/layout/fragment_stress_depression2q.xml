<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".app.form.screening.StressDepression2qFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ส่วนหัวของหน้า -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_dialog_info"
                android:tint="#673AB7"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="การคัดกรองโรคซึมเศร้าด้วย 2 คำถาม (2Q)"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2C3E50" />
        </LinearLayout>

        <!-- คำอธิบาย -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#E8F5E8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 คำแนะนำ"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#27AE60"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="กรุณาตอบคำถามเกี่ยวกับความรู้สึกของท่านใน 2 สัปดาห์ที่ผ่านมารวมทั้งวันนี้"
                    android:textSize="14sp"
                    android:textColor="#2C3E50"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำถามที่ 1 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:gravity="center"
                        android:layout_marginRight="12dp"
                        android:minWidth="28dp"
                        android:minHeight="28dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ใน 2 สัปดาห์ที่ผ่านมารวมวันนี้ ท่านรู้สึกหดหู่เศร้าหรือท้อแท้สิ้นหวัง หรือไม่"
                        android:textSize="16sp"
                        android:textColor="#2C3E50"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioGroup
                        android:id="@+id/rdoStress2qQ1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="20dp">

                        <RadioButton
                            android:id="@+id/rdoStress2qQ1_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ไม่มี"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#673AB7"
                            android:padding="12dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoStress2qQ1_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="มี"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#673AB7"
                            android:padding="12dp"
                            android:background="?android:attr/selectableItemBackground" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำถามที่ 2 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:gravity="center"
                        android:layout_marginRight="12dp"
                        android:minWidth="28dp"
                        android:minHeight="28dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ใน 2 สัปดาห์ที่ผ่านมารวมวันนี้ ท่านรู้สึกเบื่อ ทำอะไรก็ไม่เพลิดเพลิน หรือไม่"
                        android:textSize="16sp"
                        android:textColor="#2C3E50"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioGroup
                        android:id="@+id/rdoStress2qQ2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="20dp">

                        <RadioButton
                            android:id="@+id/rdoStress2qQ2_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ไม่มี"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#673AB7"
                            android:padding="12dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoStress2qQ2_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="มี"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#673AB7"
                            android:padding="12dp"
                            android:background="?android:attr/selectableItemBackground" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ส่วนแสดงผลแบบใหม่ (คล้าย nicotine) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- หัวข้อผลการประเมิน -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_dialog_info"
                        android:tint="#673AB7"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ผลการคัดกรอง 2Q"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#2C3E50" />

                    <!-- ปุ่ม info สำหรับแสดงเกณฑ์การประเมิน -->

                </LinearLayout>

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*">

                    <!-- Header Row -->
                    <TableRow
                        android:background="@drawable/gradient_header"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ผลลัพธ์"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:padding="8dp" />
                    </TableRow>

                    <!-- แถวข้อมูล 2Q -->
                    <TableRow
                        android:padding="12dp"
                        android:background="#FFFFFF">

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="2dp"
                            android:layout_margin="4dp">

                            <TextView
                                android:id="@+id/tv2qResult"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:gravity="center"
                                android:padding="12dp"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/gradient_score" />
                        </androidx.cardview.widget.CardView>
                    </TableRow>

                    <!-- แถวแสดงหัวข้อผลการประเมิน -->
                    <TableRow >

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_span="2"
                            android:text="ผลการคัดกรอง:"
                            android:gravity="center"
                            android:padding="8dp"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#2C3E50" />
                    </TableRow>

                    <!-- แถวแสดงผลลัพธ์รายละเอียด -->
                    <TableRow
                        android:background="#F8F9FA">

                        <TextView
                            android:id="@+id/tv2qResultDetail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_span="2"
                            android:text="ยังไม่ได้ประเมิน"
                            android:gravity="center"
                            android:padding="16dp"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#7F8C8D"
                            android:background="@drawable/risk_level_background"
                            android:singleLine="false"
                            android:maxLines="5"
                            android:ellipsize="none"
                            android:scrollHorizontally="false" />
                    </TableRow>
                </TableLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ส่วน Gauge ใหม่ สำหรับ 2Q -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- หัวข้อ Gauge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_dialog_info"
                        android:tint="#673AB7"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📊 สถานะผลการประเมิน"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#2C3E50" />

                    <ImageView
                        android:id="@+id/ivStress2qInfoButton"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@android:drawable/ic_dialog_info"
                        android:tint="#673AB7"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Custom Gauge View สำหรับ 2Q -->
                <th.in.ffc.app.form.screening.view.StressRiskGauge2QView
                    android:id="@+id/stressRiskGauge"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="0dp" />

                <!-- ข้อมูลระดับปัจจุบัน -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/risk_level_background"
                    android:padding="16dp">

                    <!-- คะแนนและ Emoji -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:id="@+id/tvStressGaugeEmoji"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="😊"
                                android:textSize="32sp"
                                android:layout_marginEnd="12dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvStressGaugeScore"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="คะแนน: 0/2"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="#2C3E50" />

                                <TextView
                                    android:id="@+id/tvStressGaugeLevel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ปกติ"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="#27AE60" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStressGaugeCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1B0210"
                            android:textSize="16sp"
                            android:textColor="#666666"
                            android:textStyle="bold"
                            android:background="#F0F0F0"
                            android:padding="4dp"
                            android:layout_gravity="center_horizontal" />
                    </LinearLayout>

                    <!-- คำแนะนำ -->
                    <TextView
                        android:id="@+id/tvStressGaugeRecommendation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✅ สถานะปกติ"
                        android:textSize="14sp"
                        android:textColor="#27AE60"
                        android:textStyle="italic"
                        android:gravity="center"
                        android:background="#E8F5E8"
                        android:padding="8dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- ตัวควบคุมคะแนน (สำหรับทดสอบ - สามารถลบออกได้) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    android:id="@+id/layoutStressGaugeControl">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ทดสอบ Gauge (สำหรับ Debug):"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="8dp" />

                    <SeekBar
                        android:id="@+id/seekBarStressGaugeTest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="2"
                        android:progress="0" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0"
                            android:textSize="12sp"
                            android:textColor="#666666"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="2"
                            android:textSize="12sp"
                            android:textColor="#666666"
                            android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>