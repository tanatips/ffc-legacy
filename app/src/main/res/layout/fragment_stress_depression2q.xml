<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".app.form.screening.StressDepression2qFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ส่วนหัวของหน้า -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_dialog_info"
                android:tint="#673AB7"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="การคัดกรองโรคซึมเศร้าด้วย 2 คำถาม (2Q)"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2C3E50" />
        </LinearLayout>

        <!-- คำอธิบาย -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#E8F5E8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 คำแนะนำ"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#27AE60"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="กรุณาตอบคำถามเกี่ยวกับความรู้สึกของท่านใน 2 สัปดาห์ที่ผ่านมารวมทั้งวันนี้"
                    android:textSize="14sp"
                    android:textColor="#2C3E50"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำถามที่ 1 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:gravity="center"
                        android:layout_marginRight="12dp"
                        android:minWidth="28dp"
                        android:minHeight="28dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ใน 2 สัปดาห์ที่ผ่านมารวมวันนี้ ท่านรู้สึกหดหู่เศร้าหรือท้อแท้สิ้นหวัง หรือไม่"
                        android:textSize="16sp"
                        android:textColor="#2C3E50"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioGroup
                        android:id="@+id/rdoStress2qQ1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="20dp">

                        <RadioButton
                            android:id="@+id/rdoStress2qQ1_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ไม่มี"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#673AB7"
                            android:padding="12dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoStress2qQ1_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="มี"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#673AB7"
                            android:padding="12dp"
                            android:background="?android:attr/selectableItemBackground" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำถามที่ 2 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:gravity="center"
                        android:layout_marginRight="12dp"
                        android:minWidth="28dp"
                        android:minHeight="28dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ใน 2 สัปดาห์ที่ผ่านมารวมวันนี้ ท่านรู้สึกเบื่อ ทำอะไรก็ไม่เพลิดเพลิน หรือไม่"
                        android:textSize="16sp"
                        android:textColor="#2C3E50"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioGroup
                        android:id="@+id/rdoStress2qQ2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="20dp">

                        <RadioButton
                            android:id="@+id/rdoStress2qQ2_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ไม่มี"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#673AB7"
                            android:padding="12dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoStress2qQ2_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="มี"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#673AB7"
                            android:padding="12dp"
                            android:background="?android:attr/selectableItemBackground" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ส่วนแสดงผลแบบใหม่ (คล้าย nicotine) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*">

                    <!-- Header Row -->
                    <TableRow
                        android:background="@drawable/gradient_header"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="การประเมิน"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:padding="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ผลลัพธ์"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:padding="8dp" />
                    </TableRow>

                    <!-- แถวข้อมูล 2Q -->
                    <TableRow
                        android:padding="12dp"
                        android:background="#FFFFFF">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="2"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/ic_dialog_info"
                                android:tint="#673AB7"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2Q"
                                android:textSize="14sp"
                                android:textColor="#2C3E50"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="2dp"
                            android:layout_margin="4dp">

                            <TextView
                                android:id="@+id/tv2qResult"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:gravity="center"
                                android:padding="12dp"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/gradient_score" />
                        </androidx.cardview.widget.CardView>
                    </TableRow>

                    <!-- แถวแสดงหัวข้อผลการประเมิน -->
                    <TableRow
                        android:background="#E8F5E8">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_span="2"
                            android:text="ผลการคัดกรอง:"
                            android:gravity="center"
                            android:padding="8dp"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#2C3E50" />
                    </TableRow>

                    <!-- แถวแสดงผลลัพธ์รายละเอียด -->
                    <TableRow
                        android:background="#F8F9FA">

                        <TextView
                            android:id="@+id/tv2qResultDetail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_span="2"
                            android:text="ยังไม่ได้ประเมิน"
                            android:gravity="center"
                            android:padding="16dp"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#7F8C8D"
                            android:background="@drawable/risk_level_background"
                            android:singleLine="false"
                            android:maxLines="5"
                            android:ellipsize="none"
                            android:scrollHorizontally="false" />
                    </TableRow>
                </TableLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ส่วนตารางเกณฑ์การประเมิน (แบบใหม่) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#F8F9FA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_dialog_info"
                        android:tint="#673AB7"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="เกณฑ์การคัดกรองโรคซึมเศร้า 2Q"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#2C3E50" />
                </LinearLayout>

                <!-- ระดับ 1: ปกติ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/circle_green"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ตอบ 'ไม่มี' ทั้ง 2 ข้อ: ปกติ (1B0210)"
                        android:textSize="13sp"
                        android:textColor="#27AE60" />
                </LinearLayout>

                <!-- ระดับ 2: ผิดปกติ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/circle_red"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ตอบ 'มี' อย่างน้อย 1 ข้อ: ผิดปกติ (1B0211)"
                        android:textSize="13sp"
                        android:textColor="#E74C3C" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ตารางเดิม (ซ่อนไว้) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 ผลการประเมิน"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true">

                    <TableLayout
                        android:id="@+id/depression2resultTable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="*"
                        android:shrinkColumns="*"
                        android:background="#FFFFFF">

                        <!-- หัวตาราง -->
                        <TableRow
                            android:background="#673AB7"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="ผลการคัดกรอง"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:padding="8dp"
                                android:gravity="center" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="การแปลผล"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:padding="8dp"
                                android:gravity="center" />
                        </TableRow>

                        <!-- แถวปกติ -->
                        <TableRow
                            android:padding="12dp"
                            android:background="#E8F5E8">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="ตอบว่า 'ไม่มี' ทั้ง 2 คำถาม"
                                android:textSize="15sp"
                                android:textColor="#2C3E50"
                                android:padding="8dp"
                                android:lineSpacingExtra="2dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="ปกติ\n(1B0210)"
                                android:textSize="15sp"
                                android:textColor="#27AE60"
                                android:textStyle="bold"
                                android:padding="8dp"
                                android:gravity="center"
                                android:lineSpacingExtra="2dp" />
                        </TableRow>

                        <!-- แถวผิดปกติ -->
                        <TableRow
                            android:padding="12dp"
                            android:background="#FFEBEE">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="ตอบว่า 'มี' อย่างน้อย 1 คำถาม"
                                android:textSize="15sp"
                                android:textColor="#2C3E50"
                                android:padding="8dp"
                                android:lineSpacingExtra="2dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="ผิดปกติ และส่งต่อเจ้าหน้าที่\n(1B0211)"
                                android:textSize="15sp"
                                android:textColor="#E74C3C"
                                android:textStyle="bold"
                                android:padding="8dp"
                                android:gravity="center"
                                android:lineSpacingExtra="2dp" />
                        </TableRow>
                    </TableLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>