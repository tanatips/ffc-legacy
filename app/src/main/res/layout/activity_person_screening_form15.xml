<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp"
    tools:context=".person.PersonScreeningForm15Activity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_gravity="center"
        android:text="@string/pp_fee_schedule_15_34"
        android:layout_marginBottom="20dp" />

    <!-- Header สำหรับโหมดการตรวจสอบ (แสดงเฉพาะ DEBUG) -->
    <LinearLayout
        android:id="@+id/validationModeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F0F0F0"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔧 การตั้งค่าโหมดการตรวจสอบ (DEBUG)"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#4A4A4A" />

        <ImageView
            android:id="@+id/validationModeExpandIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_expand_more_black" />

    </LinearLayout>

    <!-- Container สำหรับเนื้อหาโหมดการตรวจสอบ (พับได้) -->
    <FrameLayout
        android:id="@+id/validationModeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp">

            <!-- Switch สำหรับเปลี่ยนโหมดการตรวจสอบ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="เปิดใช้โหมดการตรวจสอบบางส่วน"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#4A4A4A" />

                <Switch
                    android:id="@+id/switchValidationMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textOff="ปกติ"
                    android:textOn="บางส่วน"
                    android:checked="false" />

            </LinearLayout>

            <!-- คำอธิบายสั้นๆ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 โหมดปกติ: ต้องทำครบทุกแบบประเมินในแต่ละหัวข้อ\n🔧 โหมดบางส่วน: ทำอย่างน้อย 1 แบบประเมินในแต่ละหัวข้อ\n⚠️ DEBUG MODE: ใช้เฉพาะการทดสอบเท่านั้น"
                android:textSize="12sp"
                android:textColor="#666666"
                android:background="#F8F9FA"
                android:padding="8dp"
                android:layout_marginTop="8dp" />

            <!-- สถานะปัจจุบัน -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:background="#E3F2FD"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="สถานะปัจจุบัน: "
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#1976D2" />

                <TextView
                    android:id="@+id/textCurrentValidationMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="โหมดปกติ"
                    android:textSize="12sp"
                    android:textColor="#1976D2"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- ส่วนอื่นๆ ของ layout เหมือนเดิม -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:layout_above="@+id/buttonLayout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ส่วนข้อมูลส่วนตัวที่สามารถขยาย/ย่อได้ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/personInfoHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@color/light_blue"
                        android:padding="12dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ข้อมูลบุคคล"
                            android:textSize="18sp"
                            android:textColor="#212121"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/personInfoExpandIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_expand_more_black" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/personInfoContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible">

                        <fragment
                            android:id="@+id/personInfoFragment"
                            android:name="th.in.ffc.app.form.screening.PersonInfoFragment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </FrameLayout>
                </LinearLayout>

                <ExpandableListView
                    android:layout_marginTop="20dp"
                    android:id="@+id/expandableListView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="#a9a9a9"
                    android:dividerHeight="1dp"
                    android:groupIndicator="@null"
                    android:childDivider="@android:color/transparent" />

                <!-- สรุปผลการคัดกรองทั้งหมด -->
                <LinearLayout
                    android:id="@+id/screeningSummaryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#F8F9FA"
                    android:padding="16dp"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <!-- หัวข้อสรุป -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_assessment"
                            android:layout_marginEnd="8dp"
                            android:tint="#1976D2" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📋 สรุปผลการคัดกรอง"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#1976D2" />

                        <TextView
                            android:id="@+id/textCompletedForms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/0"
                            android:textSize="12sp"
                            android:textColor="#666666"
                            android:background="#E3F2FD"
                            android:padding="4dp"
                            android:minWidth="40dp"
                            android:gravity="center" />

                    </LinearLayout>

                    <!-- เนื้อหาสรุป -->
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxHeight="300dp">

                        <LinearLayout
                            android:id="@+id/summaryContentContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </ScrollView>

                    <!-- ข้อมูลการให้คำปรึกษา -->
                    <LinearLayout
                        android:id="@+id/counselingInfoContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#E8F5E8"
                        android:padding="12dp"
                        android:layout_marginTop="12dp"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="💬 การให้คำปรึกษา"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#2E7D32"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="60dp"
                                android:layout_height="wrap_content"
                                android:text="ประเภท:"
                                android:textSize="12sp"
                                android:textColor="#4A4A4A" />

                            <TextView
                                android:id="@+id/textCounselingType"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="-"
                                android:textSize="12sp"
                                android:textColor="#2E7D32" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="60dp"
                                android:layout_height="wrap_content"
                                android:text="รายละเอียด:"
                                android:textSize="12sp"
                                android:textColor="#4A4A4A" />

                            <TextView
                                android:id="@+id/textCounselingDetail"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="-"
                                android:textSize="12sp"
                                android:textColor="#4A4A4A"
                                android:maxLines="2"
                                android:ellipsize="end" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ปุ่มต่างๆ เหมือนเดิม -->
        <LinearLayout
            android:id="@+id/buttonLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="10dp">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="ยกเลิก"
                android:textColor="@android:color/white"
                android:background="@drawable/button_save_background" />

            <Button
                android:id="@+id/btnOK"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="บันทึกข้อมูล"
                android:textColor="@android:color/white"
                android:background="@drawable/button_save_background" />

            <Button
                android:id="@+id/btnReCreateTable"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="re create table"
                android:textColor="@android:color/white"
                android:background="@drawable/button_save_background"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/progressBarContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@color/semi_transparent_gray"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/progressBarText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textColor="@android:color/black"
                    android:textStyle="bold"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>
    </RelativeLayout>
</LinearLayout>