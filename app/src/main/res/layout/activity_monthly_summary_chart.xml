<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".app.form.screening.report.MonthlySummaryChartActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/light_blue"
        app:titleTextColor="@color/black"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="กราฟแสดงข้อมูลรายเดือน" />

    <TextView
        android:id="@+id/text_fiscal_year"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="ปีงบประมาณ: 2567"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/bar_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="8dp" />

    <RadioGroup
        android:id="@+id/radio_group_chart_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp">

        <RadioButton
            android:id="@+id/radio_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ยอดเงิน"
            android:checked="true"
            android:layout_marginEnd="16dp" />

        <RadioButton
            android:id="@+id/radio_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="จำนวนรายการ"
            android:layout_marginStart="16dp" />

    </RadioGroup>

    <Button
        android:visibility="gone"
        android:id="@+id/button_status_chart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="ดูกราฟแยกตามสถานะ"
        style="@style/Widget.AppCompat.Button.Colored" />

</LinearLayout>