<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".app.form.screening.SmookingFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="1dp">

        <!-- ส่วนหัวของหน้า -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            >

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_smoking"
                android:tint="#E74C3C"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="คัดกรองความเสี่ยงจากการสูบบุหรี่"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2C3E50" />
        </LinearLayout>

        <!-- แบบฟอร์มการสูบบุหรี่ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_margin="10dp"
                    android:textStyle="bold"
                    android:text="@string/cigarette_form"
                    android:visibility="gone"
                    android:textSize="16sp"
                    android:textColor="#34495E"
                    android:gravity="center_vertical"
                    android:drawablePadding="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ข้อมูลการสูบบุหรี่"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#34495E"
                    android:layout_marginBottom="16dp"
                    android:drawablePadding="8dp" />

                <RadioGroup
                    android:id="@+id/rdoSmokerGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rdoSmokerGroup1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cigarette_1b52"
                        android:textSize="14sp"
                        android:textColor="#2C3E50"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/radio_button_background"
                        android:buttonTint="#E74C3C" />

                    <RadioButton
                        android:id="@+id/rdoSmokerGroup2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cigarette_1b51"
                        android:textSize="14sp"
                        android:textColor="#2C3E50"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/radio_button_background"
                        android:buttonTint="#E74C3C" />

                    <RadioButton
                        android:id="@+id/rdoSmokerGroup3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cigarette_1b50"
                        android:textSize="14sp"
                        android:textColor="#2C3E50"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/radio_button_background"
                        android:buttonTint="#E74C3C" />

                    <!-- ความถี่การสูบ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#F8F9FA"
                        android:padding="10dp"
                        android:layout_marginStart="1dp"
                        android:layout_marginBottom="8dp"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ความถี่ในการสูบ"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#7F8C8D"
                            android:layout_marginBottom="8dp" />

                        <RadioGroup
                            android:id="@+id/rdoSmokerAssist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RadioButton
                                android:id="@+id/rdoSmokerAssist1"
                                android:layout_marginLeft="0dp"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:text="@string/smoke_once_in_a_while"
                                android:textSize="13sp"
                                android:textColor="#34495E"
                                android:padding="8dp"
                                android:layout_marginBottom="4dp"
                                android:buttonTint="#FF6B35" />

                            <RadioButton
                                android:id="@+id/rdoSmokerAssist2"
                                android:layout_marginLeft="0dp"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:text="@string/smoke_occasionally"
                                android:textSize="13sp"
                                android:textColor="#34495E"
                                android:padding="8dp"
                                android:layout_marginBottom="4dp"
                                android:buttonTint="#FF6B35" />

                            <RadioButton
                                android:id="@+id/rdoSmokerAssist3"
                                android:layout_marginLeft="0dp"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:text="@string/smoke_regularly"
                                android:textSize="13sp"
                                android:textColor="#34495E"
                                android:padding="8dp"
                                android:buttonTint="#FF6B35" />
                        </RadioGroup>
                    </LinearLayout>

                    <!-- ระดับการสูบเป็นประจำ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#FFF3CD"
                        android:padding="10dp"
                        android:layout_marginStart="0dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ให้คำแนะนำ/ปรึกษา"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#856404"
                            android:layout_marginBottom="8dp" />

                        <RadioGroup
                            android:id="@+id/rdoSmokerRegularly"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RadioButton
                                android:id="@+id/rdoSmokerRegularly1"
                                android:layout_marginLeft="0dp"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:text="@string/cigarette_1b530"
                                android:textSize="13sp"
                                android:textColor="#856404"
                                android:padding="8dp"
                                android:layout_marginBottom="4dp"
                                android:buttonTint="#FF9800" />

                            <RadioButton
                                android:id="@+id/rdoSmokerRegularly2"
                                android:layout_marginLeft="0dp"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:text="@string/cigarette_1b531"
                                android:textSize="13sp"
                                android:textColor="#856404"
                                android:padding="8dp"
                                android:layout_marginBottom="4dp"
                                android:buttonTint="#FF9800" />

                            <RadioButton
                                android:id="@+id/rdoSmokerRegularly3"
                                android:layout_marginLeft="0dp"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:text="@string/cigarette_1b532"
                                android:textSize="13sp"
                                android:textColor="#856404"
                                android:padding="8dp"
                                android:buttonTint="#FF9800" />
                        </RadioGroup>
                    </LinearLayout>
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ผลการประเมินคะแนน -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- หัวข้อผลการประเมิน -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_assessment"
                        android:tint="#3498DB"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ผลการประเมินความเสี่ยง"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#2C3E50" />

                    <!-- ปุ่ม info สำหรับแสดงเกณฑ์การประเมิน -->
                    <ImageView
                        android:id="@+id/ivInfoButton"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_info"
                        android:tint="#3498DB"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- ตารางแสดงคะแนน -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="16dp">

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="*">

                        <!-- Header Row -->
                        <TableRow
                            android:background="@drawable/gradient_header"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="คะแนน"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:padding="8dp" />
                        </TableRow>

                        <!-- แถวข้อมูลบุหรี่ -->
                        <TableRow
                            android:padding="12dp"
                            android:background="#FFFFFF">

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="2dp"
                                android:layout_margin="4dp">

                                <TextView
                                    android:id="@+id/tvSmokingScore"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="-"
                                    android:gravity="center"
                                    android:padding="12dp"
                                    android:textStyle="bold"
                                    android:textSize="18sp"
                                    android:textColor="#FFFFFF"
                                    android:background="@drawable/gradient_score" />
                            </androidx.cardview.widget.CardView>
                        </TableRow>

                        <!-- แถวแสดงหัวข้อระดับความเสี่ยง -->
                        <TableRow>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_span="2"
                                android:text="ระดับความเสี่ยง:"
                                android:gravity="center"
                                android:padding="8dp"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="#2C3E50" />
                        </TableRow>

                        <!-- แถวแสดงผลลัพธ์ระดับความเสี่ยง -->
                        <TableRow
                            android:background="#F8F9FA">

                            <TextView
                                android:id="@+id/tvSmokingRiskLevel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_span="2"
                                android:text="ยังไม่ได้ประเมิน"
                                android:gravity="center"
                                android:padding="16dp"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="#7F8C8D"
                                android:background="@drawable/risk_level_background"
                                android:singleLine="false"
                                android:maxLines="5"
                                android:ellipsize="none"
                                android:scrollHorizontally="false" />
                        </TableRow>
                    </TableLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ช่องว่างด้านล่าง -->
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

    </LinearLayout>
</ScrollView>