<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">
    <!-- Layout สำหรับแสดง Gauge ใน fragment_suicide_assessment8q.xml -->

    <!-- เพิ่มส่วนนี้หลังจาก ส่วนแสดงผลแบบใหม่ (คล้าย 2Q และ 9Q) -->

    <!-- Risk Level Gauge -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- หัวข้อ Gauge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_dialog_info"
                    android:tint="#E74C3C"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📊 ระดับความเสี่ยง"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#2C3E50" />
            </LinearLayout>

            <!-- Custom Gauge View -->
            <th.in.ffc.app.form.screening.view.SuicideRiskGaugeView
                android:id="@+id/suicideRiskGauge"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginBottom="16dp" />

            <!-- ข้อมูลระดับปัจจุบัน -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/risk_level_background"
                android:padding="16dp">

                <!-- คะแนนและ Emoji -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvGaugeEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😊"
                        android:textSize="32sp"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvGaugeScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="คะแนน: 0"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#2C3E50" />

                        <TextView
                            android:id="@+id/tvGaugeLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ไม่มีความเสี่ยง"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#27AE60" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvGaugeCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1B0270"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:background="#F0F0F0"
                        android:padding="4dp"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <!-- คำแนะนำ -->
                <TextView
                    android:id="@+id/tvGaugeRecommendation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✅ สถานะปกติ"
                    android:textSize="14sp"
                    android:textColor="#27AE60"
                    android:textStyle="italic"
                    android:gravity="center"
                    android:background="#E8F5E8"
                    android:padding="8dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- ตัวควบคุมคะแนน (สำหรับทดสอบ - สามารถลบออกได้) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:id="@+id/layoutGaugeControl">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ทดสอบ Gauge (สำหรับ Debug):"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="8dp" />

                <SeekBar
                    android:id="@+id/seekBarGaugeTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="52"
                    android:progress="0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:gravity="start" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="52"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>