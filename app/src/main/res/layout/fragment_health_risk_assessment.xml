<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".app.form.screening.HealthRiskAssessmentFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:textStyle="bold"
                android:text="แบบประเมินความเสี่ยงการเกิดโรคเบาหวาน"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1.อายุ"
                android:textStyle="bold"
                android:padding="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioGroup
                    android:id="@+id/rdoHealthRiskQ1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="20dp">
                    <RadioButton
                        android:id="@+id/rdoHealthRiskQ1_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="34-39 ปี"/>
                    <RadioButton
                        android:id="@+id/rdoHealthRiskQ1_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="40-44 ปี"/>
                    <RadioButton
                        android:id="@+id/rdoHealthRiskQ1_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="45-49 ปี"/>
                    <RadioButton
                        android:id="@+id/rdoHealthRiskQ1_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="ตั้งแต่ 50 ปี ขึ้นไป"/>
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2.เพศ"
                android:textStyle="bold"
                android:padding="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioGroup
                    android:id="@+id/rdoHealthRiskQ2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="20dp">
                    <RadioButton
                        android:id="@+id/rdoHealthRiskQ2_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="หญิง"/>
                    <RadioButton
                        android:id="@+id/rdoHealthRiskQ2_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="ชาย"/>

                </RadioGroup>
            </LinearLayout>
        </LinearLayout>


    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3.ดัชนีมวลกาย"
                android:textStyle="bold"
                android:padding="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioGroup
                    android:id="@+id/rdoHealthRiskQ3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="20dp">
                    <RadioButton
                        android:id="@+id/rdoHealthRiskQ3_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="ต่ำกว่า 23 กก./ม2."/>
                    <RadioButton
                        android:id="@+id/rdoHealthRiskQ3_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="ตั้งแต่ 23 ขึ้นไปแต่ น้อยกว่า 27.5 กก/ม2."/>

                    <RadioButton
                        android:id="@+id/rdoHealthRiskQ3_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="ตั้งแต่ 27.5 กก/ม2. ขึ้นไป"/>

                </RadioGroup>
            </LinearLayout>
        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4.รอบเอว"
                android:textStyle="bold"
                android:padding="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioGroup
                    android:id="@+id/rdoHealthRiskQ4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="20dp">
                    <RadioButton
                        android:id="@+id/rdoHealthRiskQ4_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="ผู้ชายน้อยกว่า 90 ชม. ผู้หญิงน้อยกว่า 80 ซม."/>
                    <RadioButton
                        android:id="@+id/rdoHealthRiskQ4_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="ผู้ชายตั้งแต่ 90 ซม. ขึ้นไป ผู้หญิงตั้งแต่ 80 ชม. ขึ้นไป"/>
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5.ความดันโลหิต"
                android:textStyle="bold"
                android:padding="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioGroup
                    android:id="@+id/rdoHealthRiskQ5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="20dp">
                    <RadioButton
                        android:id="@+id/rdoHealthRiskQ5_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="ไม่มี"/>
                    <RadioButton
                        android:id="@+id/rdoHealthRiskQ5_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="มี"/>
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6.ประวัติโรคเบาหวานในญาติสายตรง(พ่อ แม่ พี่ น้อง)"
                android:textStyle="bold"
                android:padding="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioGroup
                    android:id="@+id/rdoHealthRiskQ6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="20dp">
                    <RadioButton
                        android:id="@+id/rdoHealthRiskQ6_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="ไม่มี"/>
                    <RadioButton
                        android:id="@+id/rdoHealthRiskQ6_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="มี"/>
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <!-- ตารางแปลผล -->
    <TextView
        android:id="@+id/resultHealthRiskScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:gravity="center"
        android:textSize="16sp"
        android:textStyle="bold"/>
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:stretchColumns="*">

        <!-- Header Row -->
        <TableRow
            android:background="@color/header_purple"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="ผลรวมคะแนน"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:text="ความเสี่ยงเบาหวาน\nใน 12 ปี"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ระดับ\nความเสี่ยง"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:textStyle="bold" />
        </TableRow>

        <!-- Score Row 1 -->
        <TableRow
            android:id="@+id/scoreRow1"
            android:padding="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center"
                android:textSize="14sp"
                android:text="น้อยกว่าหรือเท่ากับ 2"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:gravity="center"
                android:textSize="14sp"
                android:text="น้อยกว่าร้อยละ 5"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="14sp"
                android:text="เสี่ยงน้อย"/>
        </TableRow>

        <!-- Score Row 2 -->
        <TableRow
            android:id="@+id/scoreRow2"
            android:background="#F0F0F0"
            android:padding="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center"
                android:textSize="14sp"
                android:text="3-5"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:gravity="center"
                android:textSize="14sp"
                android:text="ร้อยละ 5-10"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="14sp"
                android:text="เสี่ยงปานกลาง"/>
        </TableRow>

        <!-- Score Row 3 -->
        <TableRow
            android:id="@+id/scoreRow3"
            android:padding="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center"
                android:textSize="14sp"
                android:text="6-8"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:gravity="center"
                android:textSize="14sp"
                android:text="ร้อยละ 11-20"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="14sp"
                android:text="เสี่ยงสูง"/>
        </TableRow>

        <!-- Score Row 4 -->
        <TableRow
            android:id="@+id/scoreRow4"
            android:background="#F0F0F0"
            android:padding="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center"
                android:textSize="14sp"
                android:text="มากกว่า 8"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:gravity="center"
                android:textSize="14sp"
                android:text="มากกว่าร้อยละ 20"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="14sp"
                android:text="เสี่ยงสูงมาก"/>
        </TableRow>
    </TableLayout>
    <!-- ส่วนแสดงผลการตรวจ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ระดับน้ำตาลในเลือดโดยวิธีเจาะปลายนิ้ว (FCBG)"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/edtFCBG"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="มก/ดล"
            android:inputType="numberDecimal"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ระดับพลาสมากลูโคส (FPG)"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/edtFPG"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="มก/ดล"
            android:inputType="numberDecimal"/>

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:layout_margin="16dp">

            <!-- Header Row -->
            <TableRow
                android:background="#800080"
                android:padding="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ระดับน้ำตาลในเลือด"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="การแปลผล"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </TableRow>

            <!-- Data Row 1 -->
            <TableRow
                android:id="@+id/glucoseRow1"
                android:padding="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="น้อยกว่า 100"
                    android:textSize="14sp"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ปกติ"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </TableRow>

            <!-- Data Row 2 -->
            <TableRow
                android:id="@+id/glucoseRow2"
                android:background="#F0F0F0"
                android:padding="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="100-125"
                    android:textSize="14sp"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="เสี่ยงต่อการเป็นโรคเบาหวาน"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </TableRow>

            <!-- Data Row 3 -->
            <TableRow
                android:id="@+id/glucoseRow3"
                android:padding="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ตั้งแต่ 126 ขึ้นไป"
                    android:textSize="14sp"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="เป็นโรคเบาหวาน"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </TableRow>
        </TableLayout>
    </LinearLayout>

</LinearLayout>