<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".app.form.screening.FagerstromNicotineFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ส่วนหัวของหน้า -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_smoking"
                android:tint="#E74C3C"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="แบบทดสอบการติดนิโคติน (Fagerstrom)"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2C3E50" />
        </LinearLayout>

        <!-- Hidden Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_margin="10dp"
            android:textStyle="bold"
            android:text="แบบทดสอบการติดบุหรี่"
            android:visibility="gone" />

        <!-- คำถามที่ 1 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. โดยปกติคุณสูบบุหรี่วันละกี่มวน"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:padding="8dp" />

                <RadioGroup
                    android:id="@+id/rdoNicotineQ1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="20dp">

                    <RadioButton
                        android:id="@+id/rdoNicotineQ1_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="10 มวนหรือน้อยกว่า (0 คะแนน)"
                        android:tag="0"
                        android:textSize="15sp"
                        android:textColor="#2C3E50"
                        android:buttonTint="#E74C3C"
                        android:padding="12dp"
                        android:layout_marginBottom="4dp" />

                    <RadioButton
                        android:id="@+id/rdoNicotineQ1_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="11-20 มวน (1 คะแนน)"
                        android:tag="1"
                        android:textSize="15sp"
                        android:textColor="#2C3E50"
                        android:buttonTint="#E74C3C"
                        android:padding="12dp"
                        android:layout_marginBottom="4dp" />

                    <RadioButton
                        android:id="@+id/rdoNicotineQ1_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="21-30 มวน (2 คะแนน)"
                        android:tag="2"
                        android:textSize="15sp"
                        android:textColor="#2C3E50"
                        android:buttonTint="#E74C3C"
                        android:padding="12dp"
                        android:layout_marginBottom="4dp" />

                    <RadioButton
                        android:id="@+id/rdoNicotineQ1_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="มากกว่า 31 มวน (3 คะแนน)"
                        android:tag="3"
                        android:textSize="15sp"
                        android:textColor="#2C3E50"
                        android:buttonTint="#E74C3C"
                        android:padding="12dp" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำถามที่ 2 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. หลังตื่นนอนตอนเช้าคุณสูบบุหรี่มวนแรกเมื่อไหร่"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:padding="8dp" />

                <RadioGroup
                    android:id="@+id/rdoNicotineQ2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="20dp">

                    <RadioButton
                        android:id="@+id/rdoNicotineQ2_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ภายใน 5 นาทีหลังตื่นนอน (3 คะแนน)"
                        android:tag="3"
                        android:textSize="15sp"
                        android:textColor="#2C3E50"
                        android:buttonTint="#E74C3C"
                        android:padding="12dp"
                        android:layout_marginBottom="4dp" />

                    <RadioButton
                        android:id="@+id/rdoNicotineQ2_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="6-30 นาที หลังตื่นนอน (2 คะแนน)"
                        android:tag="2"
                        android:textSize="15sp"
                        android:textColor="#2C3E50"
                        android:buttonTint="#E74C3C"
                        android:padding="12dp"
                        android:layout_marginBottom="4dp" />

                    <RadioButton
                        android:id="@+id/rdoNicotineQ2_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="31-60 นาที หลังตื่นนอน (1 คะแนน)"
                        android:tag="1"
                        android:textSize="15sp"
                        android:textColor="#2C3E50"
                        android:buttonTint="#E74C3C"
                        android:padding="12dp"
                        android:layout_marginBottom="4dp" />

                    <RadioButton
                        android:id="@+id/rdoNicotineQ2_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="มากกว่า 60 นาที (0 คะแนน)"
                        android:tag="0"
                        android:textSize="15sp"
                        android:textColor="#2C3E50"
                        android:buttonTint="#E74C3C"
                        android:padding="12dp" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำถามที่ 3 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. คุณสูบบุหรี่จัดในชั่วโมงแรกหลังตื่นนอน (สูบมากกว่าในช่วงเวลาอื่นของวัน)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:padding="8dp" />

                <RadioGroup
                    android:id="@+id/rdoNicotineQ3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="20dp">

                    <RadioButton
                        android:id="@+id/rdoNicotineQ3_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ใช่ (1 คะแนน)"
                        android:tag="1"
                        android:textSize="15sp"
                        android:textColor="#2C3E50"
                        android:buttonTint="#E74C3C"
                        android:padding="12dp"
                        android:layout_marginBottom="4dp" />

                    <RadioButton
                        android:id="@+id/rdoNicotineQ3_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ไม่ใช่ (0 คะแนน)"
                        android:tag="0"
                        android:textSize="15sp"
                        android:textColor="#2C3E50"
                        android:buttonTint="#E74C3C"
                        android:padding="12dp" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำถามที่ 4 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. บุหรี่มวนไหนที่คุณไม่อยากเลิกมากที่สุด"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:padding="8dp" />

                <RadioGroup
                    android:id="@+id/rdoNicotineQ4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="20dp">

                    <RadioButton
                        android:id="@+id/rdoNicotineQ4_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="มวนแรกตอนเช้า (1 คะแนน)"
                        android:tag="1"
                        android:textSize="15sp"
                        android:textColor="#2C3E50"
                        android:buttonTint="#E74C3C"
                        android:padding="12dp"
                        android:layout_marginBottom="4dp" />

                    <RadioButton
                        android:id="@+id/rdoNicotineQ4_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="มวนอื่นๆ (0 คะแนน)"
                        android:tag="0"
                        android:textSize="15sp"
                        android:textColor="#2C3E50"
                        android:buttonTint="#E74C3C"
                        android:padding="12dp" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำถามที่ 5 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5. คุณรู้สึกลำบากหรือยุ่งยากไหมที่ต้องอยู่ใน 'เขตปลอดบุหรี่' เช่น โรงภาพยนตร์ รถโดยสาร ร้านอาหาร"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:padding="8dp" />

                <RadioGroup
                    android:id="@+id/rdoNicotineQ5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="20dp">

                    <RadioButton
                        android:id="@+id/rdoNicotineQ5_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="รู้สึกลำบาก (1 คะแนน)"
                        android:tag="1"
                        android:textSize="15sp"
                        android:textColor="#2C3E50"
                        android:buttonTint="#E74C3C"
                        android:padding="12dp"
                        android:layout_marginBottom="4dp" />

                    <RadioButton
                        android:id="@+id/rdoNicotineQ5_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ไม่รู้สึกลำบาก (0 คะแนน)"
                        android:tag="0"
                        android:textSize="15sp"
                        android:textColor="#2C3E50"
                        android:buttonTint="#E74C3C"
                        android:padding="12dp" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำถามที่ 6 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="6. คุณยังต้องสูบบุหรี่ แม้จะเจ็บป่วย นอนพักตลอดในโรงพยาบาล"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:padding="8dp" />

                <RadioGroup
                    android:id="@+id/rdoNicotineQ6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="20dp">

                    <RadioButton
                        android:id="@+id/rdoNicotineQ6_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ใช่ (1 คะแนน)"
                        android:tag="1"
                        android:textSize="15sp"
                        android:textColor="#2C3E50"
                        android:buttonTint="#E74C3C"
                        android:padding="12dp"
                        android:layout_marginBottom="4dp" />

                    <RadioButton
                        android:id="@+id/rdoNicotineQ6_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ไม่ใช่ (0 คะแนน)"
                        android:tag="0"
                        android:textSize="15sp"
                        android:textColor="#2C3E50"
                        android:buttonTint="#E74C3C"
                        android:padding="12dp" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ผลการประเมินคะแนน -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- หัวข้อผลการประเมิน -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_assessment"
                        android:tint="#3498DB"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ผลการประเมินการติดนิโคติน"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#2C3E50" />
                </LinearLayout>

                <!-- ตารางแสดงคะแนน -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="16dp">

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="*">

                        <!-- Header Row -->
                        <TableRow
                            android:background="@drawable/gradient_header"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:text="การประเมิน"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:padding="8dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="คะแนน"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:padding="8dp" />
                        </TableRow>

                        <!-- แถวข้อมูลนิโคติน -->
                        <TableRow
                            android:padding="12dp"
                            android:background="#FFFFFF">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="2"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_smoking"
                                    android:tint="#E74C3C"
                                    android:layout_marginEnd="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Fagerstrom"
                                    android:textSize="14sp"
                                    android:textColor="#2C3E50"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="2dp"
                                android:layout_margin="4dp">

                                <TextView
                                    android:id="@+id/tvNicotineScore"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="-"
                                    android:gravity="center"
                                    android:padding="12dp"
                                    android:textStyle="bold"
                                    android:textSize="18sp"
                                    android:textColor="#FFFFFF"
                                    android:background="@drawable/gradient_score" />
                            </androidx.cardview.widget.CardView>
                        </TableRow>

                        <!-- แถวแสดงหัวข้อระดับการติดนิโคติน -->
                        <TableRow

                            android:background="#E8F5E8">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_span="2"
                                android:text="ระดับการติดนิโคติน:"
                                android:gravity="center"
                                android:padding="8dp"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="#2C3E50" />
                        </TableRow>

                        <!-- แถวแสดงผลลัพธ์ระดับการติดนิโคติน -->
                        <TableRow
                            android:background="#F8F9FA">

                            <TextView
                                android:id="@+id/tvNicotineAddictionLevel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_span="2"
                                android:text="ยังไม่ได้ประเมิน"
                                android:gravity="center"
                                android:padding="16dp"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="#7F8C8D"
                                android:background="@drawable/risk_level_background"
                                android:singleLine="false"
                                android:maxLines="5"
                                android:ellipsize="none"
                                android:scrollHorizontally="false" />
                        </TableRow>
                    </TableLayout>


                </androidx.cardview.widget.CardView>

                <!-- เกณฑ์การประเมิน -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#F8F9FA">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_info"
                                android:tint="#3498DB"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="เกณฑ์การประเมินการติดนิโคติน"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="#2C3E50" />
                        </LinearLayout>

                        <!-- ระดับ 1: 0-3 คะแนน -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/circle_green"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0-3 คะแนน: ไม่นับว่าคุณติดสารนิโคติน"
                                android:textSize="13sp"
                                android:textColor="#27AE60" />
                        </LinearLayout>

                        <!-- ระดับ 2: 4-5 คะแนน -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/circle_yellow"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4-5 คะแนน: คุณติดสารนิโคตินในระดับปานกลาง"
                                android:textSize="13sp"
                                android:textColor="#F39C12" />
                        </LinearLayout>

                        <!-- ระดับ 3: 6-7 คะแนน -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/circle_orange"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="6-7 คะแนน: คุณติดสารนิโคตินในระดับปานกลางและมีแนวโน้มอย่างมากในการพัฒนาไปเป็นการติดนิโคตินระดับสูง"
                                android:textSize="13sp"
                                android:textColor="#FF9800" />
                        </LinearLayout>

                        <!-- ระดับ 4: 8-9 คะแนน -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/circle_red"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="8-9 คะแนน: คุณติดสารนิโคตินในระดับสูง"
                                android:textSize="13sp"
                                android:textColor="#E74C3C" />
                        </LinearLayout>

                        <!-- ระดับ 5: 10 คะแนน -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/circle_dark_red"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10 คะแนน: คุณติดสารนิโคตินในระดับสูงมาก"
                                android:textSize="13sp"
                                android:textColor="#C0392B" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- เก็บส่วนเก่าเป็น Hidden สำหรับ backward compatibility -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- แสดงคะแนน -->
            <TextView
                android:id="@+id/resultFagerStromScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:gravity="center"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:background="#E3F2FD"
                android:layout_marginBottom="8dp"
                android:text="คะแนนที่ได้: - คะแนน" />

            <!-- แสดงการแปลผล -->
            <TextView
                android:id="@+id/resultInterpretation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                android:text="" />
        </LinearLayout>

        <!-- ช่องว่างด้านล่าง -->
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

    </LinearLayout>
</ScrollView>