<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".app.form.screening.AlcoholFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- ส่วนหัวของหน้า -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_alcohol"
                android:tint="#FF6B35"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="คัดกรองความเสี่ยงจากการดื่มสุรา"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2C3E50" />
        </LinearLayout>

        <!-- แบบฟอร์มการดื่มสุรา -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ข้อมูลการดื่มสุรา"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#34495E"
                    android:layout_marginBottom="16dp"
                    android:drawablePadding="8dp" />

                <RadioGroup
                    android:id="@+id/rdoDrinking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rdoDrinking1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/drink_1b600"
                        android:textSize="14sp"
                        android:textColor="#2C3E50"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/radio_button_background" />

                    <RadioButton
                        android:id="@+id/rdoDrinking2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/drink_1b601"
                        android:textSize="14sp"
                        android:textColor="#2C3E50"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/radio_button_background" />

                    <RadioButton
                        android:id="@+id/rdoDrinking3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/drink"
                        android:textSize="14sp"
                        android:textColor="#2C3E50"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/radio_button_background" />

                    <!-- ความถี่การดื่ม -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#F8F9FA"
                        android:padding="5dp"
                        android:layout_marginStart="0dp"
                        android:layout_marginBottom="8dp"
                        app:cardCornerRadius="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ความถี่ในการดื่ม"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#7F8C8D"
                            android:layout_marginBottom="8dp" />

                        <RadioGroup
                            android:id="@+id/rdoDrinkingFrequency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RadioButton
                                android:id="@+id/rdoDrinkingFrequency1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/once_in_a_while"
                                android:textSize="13sp"
                                android:textColor="#34495E"
                                android:padding="8dp"
                                android:layout_marginBottom="4dp" />

                            <RadioButton
                                android:id="@+id/rdoDrinkingFrequency2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/occasionally"
                                android:textSize="13sp"
                                android:textColor="#34495E"
                                android:padding="8dp"
                                android:layout_marginBottom="4dp" />

                            <RadioButton
                                android:id="@+id/rdoDrinkingFrequency3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/regularly"
                                android:textSize="13sp"
                                android:textColor="#34495E"
                                android:padding="8dp" />
                        </RadioGroup>
                    </LinearLayout>

                    <!-- ระดับการดื่มเป็นประจำ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#FFF3CD"
                        android:padding="5dp"
                        android:layout_marginStart="0dp"
                        app:cardCornerRadius="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ระดับการดื่มเป็นประจำ"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#856404"
                            android:layout_marginBottom="8dp" />

                        <RadioGroup
                            android:id="@+id/rdoDrinkingAlway"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RadioButton
                                android:id="@+id/rdoDrinkingAlway1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/drink_1b602"
                                android:textSize="13sp"
                                android:textColor="#856404"
                                android:padding="8dp"
                                android:layout_marginBottom="4dp" />

                            <RadioButton
                                android:id="@+id/rdoDrinkingAlway2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/drink_1b603"
                                android:textSize="13sp"
                                android:textColor="#856404"
                                android:padding="8dp"
                                android:layout_marginBottom="4dp" />

                            <RadioButton
                                android:id="@+id/rdoDrinkingAlway3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/drink_1b604"
                                android:textSize="13sp"
                                android:textColor="#856404"
                                android:padding="8dp" />
                        </RadioGroup>
                    </LinearLayout>
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ผลการประเมินคะแนนแบบเดิม (ซ่อนไว้) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- หัวข้อผลการประเมิน -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_assessment"
                        android:tint="#3498DB"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ผลการประเมินความเสี่ยง"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#2C3E50" />

                    <!-- ปุ่ม info สำหรับแสดงเกณฑ์การประเมิน -->

                </LinearLayout>

                <!-- ตารางแสดงคะแนน -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="16dp">

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="*">

                        <!-- Header Row -->
                        <TableRow
                            android:background="@drawable/gradient_header"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="คะแนน"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:padding="8dp" />
                        </TableRow>

                        <!-- แถวข้อมูลแอลกอฮอล์ -->
                        <TableRow
                            android:padding="12dp"
                            android:background="#FFFFFF">

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="2dp"
                                android:layout_margin="4dp">

                                <TextView
                                    android:id="@+id/tvAlcoholScore"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="-"
                                    android:gravity="center"
                                    android:padding="12dp"
                                    android:textStyle="bold"
                                    android:textSize="18sp"
                                    android:textColor="#FFFFFF"
                                    android:background="@drawable/gradient_score" />
                            </androidx.cardview.widget.CardView>
                        </TableRow>

                        <!-- แถวแสดงหัวข้อระดับความเสี่ยง -->
                        <TableRow>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_span="2"
                                android:text="ระดับความเสี่ยง:"
                                android:gravity="center"
                                android:padding="8dp"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="#2C3E50" />
                        </TableRow>

                        <!-- แถวแสดงผลลัพธ์ระดับความเสี่ยง -->
                        <TableRow
                            android:background="#F8F9FA">

                            <TextView
                                android:id="@+id/tvAlcoholRiskLevel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_span="2"
                                android:text="ยังไม่ได้ประเมิน"
                                android:gravity="center"
                                android:padding="16dp"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="#7F8C8D"
                                android:background="@drawable/risk_level_background"
                                android:singleLine="false"
                                android:maxLines="5"
                                android:ellipsize="none"
                                android:scrollHorizontally="false" />
                        </TableRow>
                    </TableLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ส่วน Gauge ใหม่ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- หัวข้อ Gauge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_assessment"
                        android:tint="#FF6B35"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📊 ระดับความเสี่ยงการดื่มแอลกอฮอล์"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#2C3E50" />

                    <ImageView
                        android:id="@+id/ivAlcoholInfoButton"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_info"
                        android:tint="#3498DB"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Custom Gauge View -->
                <th.in.ffc.app.form.screening.view.AlcoholRiskGaugeView
                    android:id="@+id/alcoholRiskGauge"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="0dp" />

                <!-- ข้อมูลระดับปัจจุบัน -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/risk_level_background"
                    android:padding="16dp">

                    <!-- คะแนนและ Emoji -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:id="@+id/tvGaugeEmoji"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="😊"
                                android:textSize="32sp"
                                android:layout_marginEnd="12dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvGaugeScore"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="คะแนน: 0"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="#2C3E50" />

                                <TextView
                                    android:id="@+id/tvGaugeLevel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ไม่ดื่ม"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="#27AE60" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvGaugeCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1B600"
                            android:textSize="16sp"
                            android:textColor="#666666"
                            android:textStyle="bold"
                            android:background="#F0F0F0"
                            android:padding="4dp"
                            android:layout_gravity="center_horizontal" />

                    </LinearLayout>

                    <!-- คำแนะนำ -->
                    <TextView
                        android:id="@+id/tvGaugeRecommendation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✅ สถานะปกติ"
                        android:textSize="14sp"
                        android:textColor="#27AE60"
                        android:textStyle="italic"
                        android:gravity="center"
                        android:background="#E8F5E8"
                        android:padding="8dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- ตัวควบคุมคะแนน (สำหรับทดสอบ - สามารถลบออกได้) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    android:id="@+id/layoutGaugeControl">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ทดสอบ Gauge (สำหรับ Debug):"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="8dp" />

                    <SeekBar
                        android:id="@+id/seekBarGaugeTest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="40"
                        android:progress="0" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0"
                            android:textSize="12sp"
                            android:textColor="#666666"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="40"
                            android:textSize="12sp"
                            android:textColor="#666666"
                            android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ช่องว่างด้านล่าง -->
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

    </LinearLayout>
</ScrollView>