<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".app.form.screening.StressDepressionFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ส่วนหัวของหน้า -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_dialog_info"
                android:tint="#8E44AD"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="แบบประเมินความเครียดและซึมเศร้า"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2C3E50" />
        </LinearLayout>

        <!-- คำถามที่ 1 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. มีปัญหาการนอน นอนไม่หลับหรือนอนมาก"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:padding="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioGroup
                        android:id="@+id/rdoObesityQ1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="20dp">

                        <RadioButton
                            android:id="@+id/rdoObesityQ1_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นน้อยมากหรือแทบไม่มี (0 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ1_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบางครั้ง (1 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ1_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบ่อยครั้ง (2 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ1_4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นประจำ (3 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำถามที่ 2 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. มีสมาธิน้อยลง"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:padding="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioGroup
                        android:id="@+id/rdoObesityQ2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="20dp">

                        <RadioButton
                            android:id="@+id/rdoObesityQ2_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นน้อยมากหรือแทบไม่มี (0 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ2_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบางครั้ง (1 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ2_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบ่อยครั้ง (2 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ2_4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นประจำ (3 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำถามที่ 3 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. หงุดหงิด / กระวนกระวาย / ว้าวุ่นใจ"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:padding="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioGroup
                        android:id="@+id/rdoObesityQ3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="20dp">

                        <RadioButton
                            android:id="@+id/rdoObesityQ3_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นน้อยมากหรือแทบไม่มี (0 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ3_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบางครั้ง (1 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ3_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบ่อยครั้ง (2 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ3_4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นประจำ (3 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำถามที่ 4 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. รู้สึกเบื่อ เซ็ง"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:padding="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioGroup
                        android:id="@+id/rdoObesityQ4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="20dp">

                        <RadioButton
                            android:id="@+id/rdoObesityQ4_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นน้อยมากหรือแทบไม่มี (0 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ4_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบางครั้ง (1 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ4_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบ่อยครั้ง (2 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ4_4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นประจำ (3 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำถามที่ 5 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5. ไม่อยากพบปะผู้คน"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:padding="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioGroup
                        android:id="@+id/rdoObesityQ5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="20dp">

                        <RadioButton
                            android:id="@+id/rdoObesityQ5_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นน้อยมากหรือแทบไม่มี (0 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ5_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบางครั้ง (1 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ5_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบ่อยครั้ง (2 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ5_4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นประจำ (3 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ส่วนตารางผลการประเมิน - ปรับสไตล์ใหม่ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*">

                    <!-- Header Row -->
                    <TableRow
                        android:background="@drawable/gradient_header"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="การประเมิน"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:padding="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="คะแนน"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:padding="8dp" />
                    </TableRow>

                    <!-- แถวข้อมูลความเครียด -->
                    <TableRow
                        android:padding="12dp"
                        android:background="#FFFFFF">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="2"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/ic_dialog_info"
                                android:tint="#8E44AD"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ST-5"
                                android:textSize="14sp"
                                android:textColor="#2C3E50"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="2dp"
                            android:layout_margin="4dp">

                            <TextView
                                android:id="@+id/tvStressScore"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:gravity="center"
                                android:padding="12dp"
                                android:textStyle="bold"
                                android:textSize="18sp"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/gradient_score" />
                        </androidx.cardview.widget.CardView>
                    </TableRow>

                    <!-- แถวแสดงหัวข้อระดับความเครียด -->
                    <TableRow
                        android:background="#E8F5E8">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_span="2"
                            android:text="ระดับความเครียด:"
                            android:gravity="center"
                            android:padding="8dp"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#2C3E50" />
                    </TableRow>

                    <!-- แถวแสดงผลลัพธ์ระดับความเครียด -->
                    <TableRow
                        android:background="#F8F9FA">

                        <TextView
                            android:id="@+id/tvStressLevel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_span="2"
                            android:text="ยังไม่ได้ประเมิน"
                            android:gravity="center"
                            android:padding="16dp"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#7F8C8D"
                            android:background="@drawable/risk_level_background"
                            android:singleLine="false"
                            android:maxLines="5"
                            android:ellipsize="none"
                            android:scrollHorizontally="false" />
                    </TableRow>
                </TableLayout>

                <!-- ตารางเกณฑ์การประเมิน (ปรับสไตล์ใหม่) -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#F8F9FA">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/ic_dialog_info"
                                android:tint="#8E44AD"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="เกณฑ์การประเมินความเครียดและซึมเศร้า"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="#2C3E50" />
                        </LinearLayout>

                        <!-- ระดับ 1: 0-4 คะแนน -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/circle_green"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0-4 คะแนน: เครียดน้อย (1B132)"
                                android:textSize="13sp"
                                android:textColor="#4CAF50" />
                        </LinearLayout>

                        <!-- ระดับ 2: 5-7 คะแนน -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/circle_yellow"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5-7 คะแนน: เครียดปานกลาง (1B133)"
                                android:textSize="13sp"
                                android:textColor="#F57F17" />
                        </LinearLayout>

                        <!-- ระดับ 3: 8-9 คะแนน -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/circle_orange"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
