                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ2_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบางครั้ง (1 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ2_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบ่อยครั้ง (2 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ2_4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นประจำ (3 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำถามที่ 3 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. หงุดหงิด / กระวนกระวาย / ว้าวุ่นใจ"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:padding="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioGroup
                        android:id="@+id/rdoObesityQ3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="20dp">

                        <RadioButton
                            android:id="@+id/rdoObesityQ3_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นน้อยมากหรือแทบไม่มี (0 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ3_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบางครั้ง (1 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ3_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบ่อยครั้ง (2 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ3_4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นประจำ (3 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำถามที่ 4 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. รู้สึกเบื่อ เซ็ง"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:padding="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioGroup
                        android:id="@+id/rdoObesityQ4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="20dp">

                        <RadioButton
                            android:id="@+id/rdoObesityQ4_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นน้อยมากหรือแทบไม่มี (0 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ4_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบางครั้ง (1 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ4_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบ่อยครั้ง (2 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ4_4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นประจำ (3 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- คำถามที่ 5 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5. ไม่อยากพบปะผู้คน"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:padding="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioGroup
                        android:id="@+id/rdoObesityQ5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="20dp">

                        <RadioButton
                            android:id="@+id/rdoObesityQ5_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นน้อยมากหรือแทบไม่มี (0 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ5_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบางครั้ง (1 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ5_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นบ่อยครั้ง (2 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp"
                            android:layout_marginBottom="4dp" />

                        <RadioButton
                            android:id="@+id/rdoObesityQ5_4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="เป็นประจำ (3 คะแนน)"
                            android:textSize="15sp"
                            android:textColor="#2C3E50"
                            android:buttonTint="#8E44AD"
                            android:padding="12dp" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ส่วนตารางผลการประเมิน - ปรับสไตล์ใหม่ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- หัวข้อผลการประเมิน -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_dialog_info"
                        android:tint="#8E44AD"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ผลการประเมินความเครียด"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#2C3E50" />

                    <!-- ปุ่ม info สำหรับแสดงเกณฑ์การประเมิน -->

                </LinearLayout>

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*">

                    <!-- Header Row -->
                    <TableRow
                        android:background="@drawable/gradient_header"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="คะแนน"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:padding="8dp" />
                    </TableRow>

                    <!-- แถวข้อมูลความเครียด -->
                    <TableRow
                        android:padding="12dp"
                        android:background="#FFFFFF">

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="2dp"
                            android:layout_margin="4dp">

                            <TextView
                                android:id="@+id/tvStressScore"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:gravity="center"
                                android:padding="12dp"
                                android:textStyle="bold"
                                android:textSize="18sp"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/gradient_score" />
                        </androidx.cardview.widget.CardView>
                    </TableRow>

                    <!-- แถวแสดงหัวข้อระดับความเครียด -->
                    <TableRow>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_span="2"
                            android:text="ระดับความเครียด:"
                            android:gravity="center"
                            android:padding="8dp"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#2C3E50" />
                    </TableRow>

                    <!-- แถวแสดงผลลัพธ์ระดับความเครียด -->
                    <TableRow
                        android:background="#F8F9FA">

                        <TextView
                            android:id="@+id/tvStressLevel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_span="2"
                            android:text="ยังไม่ได้ประเมิน"
                            android:gravity="center"
                            android:padding="16dp"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#7F8C8D"
                            android:background="@drawable/risk_level_background"
                            android:singleLine="false"
                            android:maxLines="5"
                            android:ellipsize="none"
                            android:scrollHorizontally="false" />
                    </TableRow>
                </TableLayout>
                <!-- ตารางเดิม (ซ่อนไว้หรือลบออก) -->
                <TableLayout
                    android:id="@+id/stressScoreTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1"
                    android:background="#FFFFFF"
                    android:visibility="gone">

                    <!-- ตารางจะถูกสร้างจาก Java code ใน initializeTable() method -->
                    <!-- Header: คะแนน | ความเครียด | รหัส -->
                    <!-- Row 1: 0 - 4 | เครียดน้อย | 1B132 -->
                    <!-- Row 2: 5 - 7 | เครียดปานกลาง | 1B133 -->
                    <!-- Row 3: 8 - 9 | เครียดมาก | 1B134 -->
                    <!-- Row 4: 10 - 15 | เครียดมากที่สุด | 1B135 -->

                </TableLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- เพิ่มส่วนนี้ใน fragment_stress_depression.xml หลังจาก ส่วนตารางผลการประเมิน -->

        <!-- ส่วน Stress Gauge -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- หัวข้อ Stress Gauge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_dialog_info"
                        android:tint="#8E44AD"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="มาตรวัดความเครียด"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#2C3E50" />
                    <ImageView
                        android:id="@+id/ivStressInfoButton"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@android:drawable/ic_dialog_info"
                        android:tint="#8E44AD"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Stress Gauge View -->
                <th.in.ffc.app.form.screening.view.StressRiskGaugeST5View
                    android:id="@+id/stressRiskGauge"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="16dp" />

                <!-- ข้อมูลแสดงผล -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <!-- Emoji และคะแนน -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvStressGaugeEmoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
