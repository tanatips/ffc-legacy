<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- ไอคอนเตือน -->

    <!-- ข้อความหลัก -->
    <TextView
        android:id="@+id/tvAgeMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="ข้อความเตือนเกี่ยวกับอายุ"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <!-- ข้อมูลอายุปัจจุบัน -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/rounded_background_info"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvAgeInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="อายุปัจจุบันของท่าน: XX ปี"
            android:textColor="@color/info_color"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ข้อมูลเกณฑ์อายุ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/rounded_background_success"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="📊 เกณฑ์อายุสำหรับแบบประเมิน"
            android:textColor="@color/success_color"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="✅ อายุ 15-34 ปี: การคัดกรองพื้นฐาน\n✅ อายุ 35-59 ปี: การคัดกรองแบบละเอียด"
            android:textColor="@color/success_text"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
</ScrollView>