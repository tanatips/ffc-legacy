<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/assistScrollView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- หัวข้อหลัก -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="5dp"
                android:background="@drawable/gradient_header">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_assessment"
                    android:tint="#FFFFFF"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📊 สรุปคะแนนแบบคัดกรอง ASSIST"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center_vertical" />

                <!-- ปุ่ม Info -->
                <ImageView
                    android:id="@+id/btnInfo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    android:tint="#FFFFFF"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="ดูเกณฑ์การประเมิน" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ตารางคะแนน -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="*"
                android:padding="0dp">

                <!-- Header Row -->
                <TableRow
                    android:padding="0dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:text="ประเภทสารเสพติด"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:background="@drawable/gradient_header"
                        android:padding="12dp"
                        android:gravity="center"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="คะแนน"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/gradient_header"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:layout_marginStart="2dp" />
                </TableRow>

                <!-- Row 1: ยาสูบ -->
                <TableRow
                    android:padding="4dp"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        android:text="🚬 a. ยาสูบ (บุหรี่, ซิการ์, ฯลฯ)"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#F8F9FA"
                        android:gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvScoreA"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:text="-"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#FFFFFF"
                        android:layout_marginStart="2dp"
                        android:minHeight="48dp" />
                </TableRow>

                <!-- Row 2: แอลกอฮอล์ -->
                <TableRow
                    android:padding="4dp"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        android:text="🍺 b. แอลกอฮอล์ (สุรา, เบียร์, ไวน์)"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#EEEEEE"
                        android:gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvScoreB"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:text="-"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#FFFFFF"
                        android:layout_marginStart="2dp"
                        android:minHeight="48dp" />
                </TableRow>

                <!-- Row 3: กัญชา -->
                <TableRow
                    android:padding="4dp"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        android:text="🌿 c. กัญชา (กัญชาแห้ง, ยางกัญชา)"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#F8F9FA"
                        android:gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvScoreC"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:text="-"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#FFFFFF"
                        android:layout_marginStart="2dp"
                        android:minHeight="48dp" />
                </TableRow>

                <!-- Row 4: โคเคน -->
                <TableRow
                    android:padding="4dp"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        android:text="❄️ d. โคเคน (โค้ก, แครัก)"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#EEEEEE"
                        android:gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvScoreD"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:text="-"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#FFFFFF"
                        android:layout_marginStart="2dp"
                        android:minHeight="48dp" />
                </TableRow>

                <!-- Row 5: แอมเฟตามีน -->
                <TableRow
                    android:padding="4dp"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        android:text="💊 e. แอมเฟตามีน (ยาบ้า, ยาอี, ไอซ์)"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#F8F9FA"
                        android:gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvScoreE"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:text="-"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#FFFFFF"
                        android:layout_marginStart="2dp"
                        android:minHeight="48dp" />
                </TableRow>

                <!-- Row 6: สารระเหย -->
                <TableRow
                    android:padding="4dp"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        android:text="🧪 f. สารระเหย (กาว, ทินเนอร์, เบนซิน)"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#EEEEEE"
                        android:gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvScoreF"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:text="-"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#FFFFFF"
                        android:layout_marginStart="2dp"
                        android:minHeight="48dp" />
                </TableRow>

                <!-- Row 7: ยากล่อมประสาท -->
                <TableRow
                    android:padding="4dp"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        android:text="😴 g. ยากล่อมประสาท (วาเลี่ยม, โรฮิปนอล)"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#F8F9FA"
                        android:gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvScoreG"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:text="-"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#FFFFFF"
                        android:layout_marginStart="2dp"
                        android:minHeight="48dp" />
                </TableRow>

                <!-- Row 8: ยาหลอนประสาท -->
                <TableRow
                    android:padding="4dp"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        android:text="🌈 h. ยาหลอนประสาท (แอลเอสดี, เห็ดเมา)"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#EEEEEE"
                        android:gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvScoreH"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:text="-"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#FFFFFF"
                        android:layout_marginStart="2dp"
                        android:minHeight="48dp" />
                </TableRow>

                <!-- Row 9: สารกลุ่มฝิ่น -->
                <TableRow
                    android:padding="4dp"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        android:text="💉 i. สารกลุ่มฝิ่น (ฝิ่น, เฮโรอีน, มอร์ฟีน)"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#F8F9FA"
                        android:gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvScoreI"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:text="-"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#FFFFFF"
                        android:layout_marginStart="2dp"
                        android:minHeight="48dp" />
                </TableRow>

                <!-- Row 10: สารอื่น ๆ -->
                <TableRow
                    android:padding="4dp"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        android:text="🔬 j. สารเสพติดอื่น ๆ"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#EEEEEE"
                        android:gravity="center_vertical" />
                    <TextView
                        android:id="@+id/tvScoreJ"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:text="-"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#FFFFFF"
                        android:layout_marginStart="2dp"
                        android:minHeight="48dp" />
                </TableRow>

            </TableLayout>
        </androidx.cardview.widget.CardView>

        <!-- ช่องว่างด้านล่าง -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>

</ScrollView>