<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ข้อมูลผู้ป่วยและยอดเงิน -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPatientName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ชื่อ นามสกุล"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvIdCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="เลขบัตรประชาชน: X-XXXX-XXXXX-XX-X"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvClaimAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="500.00 บาท"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />
        </LinearLayout>

        <!-- ข้อมูลวันที่และสถานะ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvServiceDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="วันที่รับบริการ: 01/01/2025"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvClaimDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="วันที่ทำรายการ: 01/01/2025"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvClaimStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="สถานะ: อนุมัติ"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/holo_green_dark" />
        </LinearLayout>

        <!-- ปุ่มดำเนินการ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnViewDetails"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="ดูรายละเอียด"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:backgroundTint="@android:color/holo_green_dark"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnCheckStatus"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="ตรวจสอบสถานะการเบิก"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:backgroundTint="@android:color/holo_green_dark"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>